# Ushbu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.

# @BotFather bergan token
BOT_TOKEN=

# Sizning Telegram ID raqamingiz (botga /id yozib bilib olasiz).
# Bir nechta ega bo'lsa — vergul bilan: OWNER_TG_ID=111111,222222
OWNER_TG_ID=

# Baza.
# Tez sinash uchun (hech narsa o'rnatmasdan):
DATABASE_URL=sqlite+aiosqlite:///moliyachi.db
# Ishlab chiqarish uchun PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://moliyachi:PAROL@localhost:5432/moliyachi

# Aisha / VoiceLab (ovoz -> matn, o'zbekchaga ixtisoslashgan) — voicelab.uz -> API kalitlari
# Kalit bo'lmasa yoki Aisha ishlamasa — ElevenLabs ishlatiladi
AISHA_API_KEY=
# Faqat ElevenLabs ishlatish uchun: STT_PROVIDER=elevenlabs
# STT_PROVIDER=aisha

# ElevenLabs (ovoz -> matn, zaxira)
ELEVENLABS_API_KEY=

# Anthropic (Claude) — console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_ADVICE_MODEL=claude-sonnet-5-5

TIMEZONE=Asia/Tashkent

# Kuzatuv boti (ixtiyoriy): @BotFather -> /newbot bilan ALOHIDA bot oching va tokenini shu yerga yozing.
# Foydalanuvchilar nima yozgani, bot nima javob bergani, ilovada nima qilgani va xatolar shu botga keladi.
# MONITOR_BOT_TOKEN=
# Kuzatuv botini kim ishlata oladi (sizning ID). Yozilmasa — OWNER_TG_ID dagi birinchi ID
# ADMIN_TG_ID=

# Serverda (Render) avtomatik. O'z domeningiz bo'lsa: PUBLIC_URL=https://sizning-domen.uz
# PUBLIC_URL=
# Serverda bot o'zini uyg'oq ushlab turadi (kundalik eslatma vaqtida yuborilishi uchun). O'chirish: KEEP_AWAKE=0
# KEEP_AWAKE=1
# Faqat kompyuterda: Telegramsiz brauzerda ilovani egasi sifatida ochish
# WEBAPP_DEV=1
